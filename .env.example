# ==========================================================================
# Cyborg Frontend (Next.js) — example environment config
# Copy this file to `.env.local` and fill in real values before `npm run dev`.
# All vars are NEXT_PUBLIC_* because they are read in the browser.
# ==========================================================================

# Base URL of the Cyborg backend API.
# Must match the port the backend runs on (backend default: 5001).
NEXT_PUBLIC_API_URL=http://localhost:5001

# Google OAuth client ID (from Google Cloud Console > Credentials).
# Use your OWN client ID and add http://localhost:3000 to its
# "Authorized JavaScript origins". Leave blank to disable Google login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: separate base URL for the chat API. Leave blank to reuse
# NEXT_PUBLIC_API_URL above.
NEXT_PUBLIC_CHAT_API_URL=
